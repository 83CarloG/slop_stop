{
  "name": "slop-stop",
  "version": "0.0.0",
  "private": true,
  "description": "Minimal Luminous scaffold for a governed AI application.",
  "type": "commonjs",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch server/start.js",
    "setup:harness": "node scripts/setupHarness.js",
    "smoke:codex": "node --env-file-if-exists=.env scripts/smokeCodex.js",
    "smoke:codex-review": "node --env-file-if-exists=.env scripts/smokeCodexReview.js",
    "start": "node --env-file-if-exists=.env server/start.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:architecture": "node --test tests/architecture.test.js"
  },
  "dependencies": {
    "@fastify/static": "10.1.3",
    "@fastify/swagger": "9.8.1",
    "@fastify/swagger-ui": "6.1.1",
    "fastify": "5.12.1"
  }
}
