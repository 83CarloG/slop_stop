{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "message"],
  "properties": {
    "status": {
      "const": "ready"
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    }
  }
}

