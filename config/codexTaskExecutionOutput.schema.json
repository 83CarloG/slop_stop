{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "validationNotes"],
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "validationNotes": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    }
  }
}
